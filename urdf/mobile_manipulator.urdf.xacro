<?xml version="1.0"?>
<robot name="mobile_manipulator" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="use_sim" default="true" />
  <xacro:arg name="prefix"  default="" />

  <!-- ────────────────────────────────────────────────
       Scout Mini  (base + wheels + LiDAR + D435 + IMU)
  ──────────────────────────────────────────────────── -->
  <xacro:include filename="$(find scout_description)/urdf/sm.xacro" />
  <xacro:scout_mini_gazebo />

  <!-- ────────────────────────────────────────────────
       알루미늄 프로파일 4개 (40×40mm, 650mm)
       Isaac Sim setup_mobile_manipulator.py 값 그대로
       차체 상단(0.069, 메시 실측) + 프로파일 절반(0.325) = 0.394
  ──────────────────────────────────────────────────── -->
  <xacro:macro name="profile" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.04 0.04 0.65"/></geometry>
        <material name="aluminum_silver">
          <color rgba="0.85 0.85 0.85 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><box size="0.04 0.04 0.65"/></geometry>
      </collision>
      <inertial>
        <mass value="0.6"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.021" ixy="0" ixz="0" iyy="0.021" iyz="0" izz="0.00005"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.394" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- x,y: Isaac Sim setup_mobile_manipulator.py PILLAR_XY 그대로
       profile_2 원본 (0.019, 0.001) 은 이상하므로 profile_1 대칭값으로 교체 -->
  <xacro:profile name="profile_fr" x=" 0.15579" y=" 0.11845"/>
  <xacro:profile name="profile_fl" x=" 0.15579" y="-0.11845"/>
  <xacro:profile name="profile_rr" x="-0.15387" y=" 0.11381"/>
  <xacro:profile name="profile_rl" x="-0.15291" y="-0.11394"/>

  <!-- ────────────────────────────────────────────────
       상판 (350×277×5mm, 알루미늄)
       plate_w = |x_max - x_min| + 0.04 = 0.311 + 0.04 = 0.350
       plate_d = |y_max - y_min| + 0.04 = 0.237 + 0.04 = 0.277
       plate_cx ≈ 0,  plate_cy ≈ 0
       차체 상단(0.069) + 프로파일(0.65) + 상판 절반(0.0025) = 0.7215
  ──────────────────────────────────────────────────── -->
  <link name="top_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.350 0.277 0.005"/></geometry>
      <material name="aluminum_silver2">
        <color rgba="0.78 0.78 0.82 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.350 0.277 0.005"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>
  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate"/>
    <origin xyz="0.001 0.0 0.7215" rpy="0 0 0"/>
  </joint>

  <!-- ────────────────────────────────────────────────
       OpenMANIPULATOR-X  (arm + gripper)
  ──────────────────────────────────────────────────── -->
  <xacro:include filename="$(find open_manipulator_x_description)/gazebo/materials.xacro" />
  <xacro:include filename="$(find open_manipulator_x_description)/urdf/open_manipulator_x.urdf.xacro" />
  <xacro:include filename="$(find open_manipulator_x_description)/gazebo/open_manipulator_x.gazebo.xacro" />
  <xacro:include filename="$(find open_manipulator_x_description)/ros2_control/open_manipulator_x_system.ros2_control.xacro" />

  <xacro:open_manipulator_x        prefix="$(arg prefix)" />
  <xacro:open_manipulator_x_gazebo prefix="$(arg prefix)" />

  <!-- 팔 링크 중력 비활성화: 컨트롤러 없이도 쓰러지지 않음 -->
  <gazebo reference="$(arg prefix)link2"><gravity>false</gravity></gazebo>
  <gazebo reference="$(arg prefix)link3"><gravity>false</gravity></gazebo>
  <gazebo reference="$(arg prefix)link4"><gravity>false</gravity></gazebo>
  <gazebo reference="$(arg prefix)link5"><gravity>false</gravity></gazebo>
  <gazebo reference="$(arg prefix)gripper_left_link"><gravity>false</gravity></gazebo>
  <gazebo reference="$(arg prefix)gripper_right_link"><gravity>false</gravity></gazebo>

  <!-- ────────────────────────────────────────────────
       고정 조인트: base_link → 로봇팔 link1 (후방 배치)
       x=-0.12757 후방 배치: LiDAR 전방 시야 확보
  ──────────────────────────────────────────────────── -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="$(arg prefix)link1"/>
    <!-- 차체 상단(0.069) + 프로파일(0.65) + 상판(0.005) = 0.724 -->
    <origin xyz="-0.12757 0.0 0.724" rpy="0 0 3.14159"/>
  </joint>

</robot>
